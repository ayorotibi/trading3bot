# Copy this file to .env for running on your own computer.
# On Render, set the same names under the service's Environment tab instead.
# Never commit your real .env file (it's in .gitignore).

# Alpaca keys: https://app.alpaca.markets -> (Paper account) -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# true = paper trading (fake money). To trade real money you must set this to
# false AND set LIVE_TRADING_CONFIRM to the exact phrase below, with live keys.
ALPACA_PAPER=true
# LIVE_TRADING_CONFIRM=I-UNDERSTAND-THIS-USES-REAL-MONEY

# true = log what it would do, place no orders
DRY_RUN=false

# Alerts: fill in Telegram, Discord, or both
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Only needed if congress.source is "quiver"
QUIVER_API_TOKEN=

LOG_LEVEL=INFO

# Trade log page (python -m bot.dashboard). Pick a strong password, 8+ characters.
DASHBOARD_PASSWORD=
DASHBOARD_TIMEZONE=Europe/London
